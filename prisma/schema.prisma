generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  EMPREENDEDOR
  EMPRESA
  ONG
  ASSOCIACAO
  EDUCACAO
  COOPERATIVA
}

enum PlanType {
  FREE
  PREMIUM
  BUSINESS
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  password     String
  phone        String?
  avatar       String?
  coverPhoto   String?
  accountType  AccountType @default(EMPREENDEDOR)
  role         String      @default("user")
  plan         PlanType    @default(FREE)
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])

  resetToken        String?
  resetTokenExpires DateTime?
  tokenVersion      Int       @default(0)

  profile         Profile?
  companyProfile  CompanyProfile?
  ngoProfile      NGOProfile?
  educationProfile EducationProfile?
  employees       Employee[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dados comuns
  nome            String
  nif             String?
  telefone        String?
  endereco        String?
  provincia       String?
  municipio       String?
  bairro          String?
  descricao       String?
  logo            String?

  // Dados pessoais (empreendedor, associacao, cooperativa)
  nomeComercial   String?
  bi              String?
  dataNascimento  DateTime?
  sexo            String?
  pais            String?
  areaActividade  String?
  profissao       String?
  servicosDescricao String?
  redesSociais    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CompanyProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nomeEmpresa      String
  nif              String?
  registoComercial String?
  anoFundacao      Int?
  numColaboradores Int?
  descricao        String?
  missao           String?
  visao            String?
  valores          String?
  pais             String?
  provincia        String?
  municipio        String?
  bairro           String?
  endereco         String?
  gpsLocation      String?
  ramoActividade   String?
  categoria        String?
  website          String?
  facebook         String?
  instagram        String?
  linkedin         String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model NGOProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nome         String
  missao       String
  areaActuacao String
  website      String?
  facebook     String?
  instagram    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EducationProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  nomeInstituicao  String
  tipo             String   // escola, universidade, centro
  cursos           String?
  website          String?
  facebook         String?
  instagram        String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Company {
  id                  String   @id @default(cuid())
  name                String
  nif                 String?
  email               String?
  phone               String?
  address             String?
  logo                String?
  whatsappNumber      String?
  whatsappStore       String?
  provinciaOperacao   String?
  horarioFuncionamento String?
  corPrincipal        String   @default("#2563eb")
  descricaoLoja       String?
  sobreNos            String?
  users               User[]
  services            Service[]
  customers           Customer[]
  products            Product[]
  categories          Category[]
  sales               Sale[]
  purchases           Purchase[]
  expenses            Expense[]
  invoices            Invoice[]
  campaigns           Campaign[]
  employees           Employee[]
  students            Student[]
opportunities       Opportunity[]
  invites             Invite[]
  quotes              Quote[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  transactions        Transaction[]
  reports             Report[]
  cargos              Cargo[]
  cargoPermissions    CargoPermission[]
  events              Event[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  acquisitionCode     String?     @unique
  subCompanies        SubCompany[] @relation("SubCompanies")
}

model SubCompany {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation("SubCompanies", fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  // SUBEMPRESA | ORGANIZACAO | FILIAL | SUCURSAL
  type        String   @default("SUBEMPRESA")
  sector      String?
  address     String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Student {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String
  email          String?
  phone          String?
  nif            String?
  address        String?
  birthDate      DateTime?
  grade          String?
  enrollmentDate DateTime @default(now())
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
}

model Customer {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  email      String?
  phone      String?
  nif        String?
  address    String?
  type       String   @default("particular")
  notes      String?
  sales      Sale[]
  stage      String?  @default("lead")
  opportunities Opportunity[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model Opportunity {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  title       String
  value       Decimal    @default(0) @db.Decimal(18, 2)
  stage       String   @default("lead")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
}

model Category {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  name       String
  products   Product[]

  @@index([companyId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Decimal @db.Decimal(18, 2)
  cost        Decimal    @default(0) @db.Decimal(18, 2)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  image       String?
  unit        String   @default("un")
  active      Boolean       @default(true)
  saleItems   SaleItem[]
  purchaseItems PurchaseItem[]
  stockMovements StockMovement[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([companyId])
  @@index([categoryId])
}

model Sale {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id])
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  date       DateTime   @default(now())
  total      Decimal @db.Decimal(18, 2)
  status     String     @default("pending")
  paymentMethod String?
  notes      String?
  items      SaleItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([companyId])
  @@index([customerId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(18, 2)
  total     Decimal @db.Decimal(18, 2)

  @@index([saleId])
  @@index([productId])
}

model Purchase {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  supplier  String?
  date      DateTime      @default(now())
  total     Decimal @db.Decimal(18, 2)
  status    String        @default("pending")
  notes     String?
  items     PurchaseItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([companyId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal @db.Decimal(18, 2)
  total      Decimal @db.Decimal(18, 2)

  @@index([purchaseId])
  @@index([productId])
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  description String
  amount      Decimal @db.Decimal(18, 2)
  category    String   @default("outros")
  date        DateTime @default(now())
  paid        Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String
  quantity  Int
  notes     String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model Invoice {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  number      String
  customer    String?
  customerEmail String?
  customerPhone String?
  customerNif String?
  date        DateTime     @default(now())
  dueDate     DateTime?
  subtotal    Decimal        @default(0) @db.Decimal(18, 2)
  discountType String      @default("fixed")
  discountValue Decimal      @default(0) @db.Decimal(18, 2)
  discount    Decimal        @default(0) @db.Decimal(18, 2)
  installments Int         @default(1)
  currency    String       @default("AOA")
  paymentMethod String?
  bankDetails String?
  total       Decimal @db.Decimal(18, 2)
  paidAmount  Decimal        @default(0) @db.Decimal(18, 2)
  status      String       @default("pending")
  notes       String?
  items       InvoiceItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity  Int
  unitPrice Decimal @db.Decimal(18, 2)
  total     Decimal @db.Decimal(18, 2)

  @@index([invoiceId])
}

model Quote {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  number    String
  customer  String?
  customerEmail String?
  customerPhone String?
  customerNif String?
  date      DateTime    @default(now())
  validUntil DateTime?
  subtotal  Decimal       @default(0) @db.Decimal(18, 2)
  discountType String   @default("fixed")
  discountValue Decimal   @default(0) @db.Decimal(18, 2)
  discount  Decimal       @default(0) @db.Decimal(18, 2)
  installments Int      @default(1)
  currency  String      @default("AOA")
  paymentMethod String?
  bankDetails String?
  total     Decimal @db.Decimal(18, 2)
  status    String      @default("pending")
  notes     String?
  items     QuoteItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity  Int
  unitPrice Decimal @db.Decimal(18, 2)
  total     Decimal @db.Decimal(18, 2)

  @@index([quoteId])
}

model Service {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  price       Decimal @db.Decimal(18, 2)
  duration    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model Campaign {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  type        String   @default("email")
  status      String   @default("draft")
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal? @db.Decimal(18, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model Cargo {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // owner | manager | collaborator | viewer
  level       String     @default("collaborator")
  isDefault   Boolean    @default(false)
  active      Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Employee {
  id         String      @id @default(cuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id])
  userId     String?     @unique
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  cargoId    String?
  cargo      Cargo?      @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  name       String
  email      String?
  phone      String?
  position   String?
  isOwner    Boolean     @default(false)
  salary     Decimal      @default(0) @db.Decimal(18, 2)
  hireDate   DateTime?
  active     Boolean     @default(true)
  attendances Attendance[]
  vacations  Vacation[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  status     String   @default("present")
  notes      String?

  @@unique([employeeId, date])
  @@index([employeeId])
}

model Vacation {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  status     String   @default("pending")
  notes      String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

enum ContentType {
  VIDEO
  POST
  BOOK
  ARTICLE
}

model Content {
  id          String      @id @default(cuid())
  title       String
  type        ContentType
  url         String
  description String?
  thumbnail   String?
  author      String?
  tags        String?
  featured    Boolean     @default(false)
  published   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Resource {
  id          String               @id @default(cuid())
  key         String               @unique
  label       String
  description String?
  icon        String?
  enabled     Boolean              @default(true)
  permissions ResourcePermission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ResourcePermission {
  id          String     @id @default(cuid())
  resourceId  String
  resource    Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  accountType AccountType
  allowed     Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([resourceId, accountType])
}

// Permissões por nível de cargo e por empresa (RBAC dinâmico)
model CargoPermission {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // owner | manager | collaborator | viewer
  cargoLevel String
  feature    String
  access     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, cargoLevel, feature])
  @@index([cargoLevel, feature])
}

model Invite {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  token       String      @unique
  email       String?
  role        String      @default("user")
  accountType AccountType
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())
  expiresAt   DateTime

  @@index([companyId])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Transaction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  type        String
  description String
  amount      Decimal @db.Decimal(18, 2)
  refType     String?
  refId       String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([refType, refId])
}

model Report {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  period       String
  periodKey    String
  label        String
  data         Json?
  totalRevenue Decimal    @default(0) @db.Decimal(18, 2)
  totalExpenses Decimal   @default(0) @db.Decimal(18, 2)
  netResult    Decimal    @default(0) @db.Decimal(18, 2)
  totalSales   Int      @default(0)
  invoicesPaid Int      @default(0)
  invoicesPaidTotal Decimal @default(0) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  @@unique([companyId, period, periodKey])
  @@index([companyId])
}

model Notification {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  type           String
  title          String
  message        String?
  link           String?
  requiresUpdate Boolean  @default(false)
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([companyId])
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  message        String?
  link           String?
  requiresUpdate Boolean  @default(false)
  createdBy      String?
  createdAt      DateTime @default(now())
}

// ---- Eventos & Bilhetes ----
// Gestão interna de eventos por empresa: tipos de bilhete (convite/ingresso/
// bilhete) e emissão de bilhetes com código único + check-in na entrada.
model Event {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  // concerto | conferencia | workshop | desporto | cultural | religioso | outro
  category           String?
  venue              String?   // local do evento
  address            String?
  province           String?
  municipality       String?
  startDate          DateTime
  endDate            DateTime?
  coverImage         String?
  // "valor da compra local do evento": custo/despesa local para realizar o evento
  localPurchaseValue Decimal   @default(0) @db.Decimal(18, 2)
  // número total de ingressos planeados (soma dos tipos, mantido para consulta)
  totalTickets       Int       @default(0)
  // RASCUNHO | PUBLICADO | ESGOTADO | CANCELADO | TERMINADO
  status             String    @default("RASCUNHO")
  published          Boolean   @default(false)
  notes              String?
  ticketTypes        EventTicketType[]
  tickets            EventTicket[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId])
  @@index([startDate])
}

model EventTicketType {
  id          String        @id @default(cuid())
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  // CONVITE | INGRESSO | BILHETE
  kind        String        @default("INGRESSO")
  description String?
  price       Decimal       @default(0) @db.Decimal(18, 2)
  // número de ingressos deste tipo (quantidade planeada)
  quantity    Int           @default(0)
  active      Boolean       @default(true)
  tickets     EventTicket[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([eventId])
}

model EventTicket {
  id           String           @id @default(cuid())
  eventId      String
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypeId String?
  ticketType   EventTicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  code         String           @unique
  holderName   String?
  holderEmail  String?
  holderPhone  String?
  price        Decimal          @default(0) @db.Decimal(18, 2)
  // VALIDO | USADO | CANCELADO
  status       String           @default("VALIDO")
  checkedIn    Boolean          @default(false)
  checkedInAt  DateTime?
  notes        String?
  issuedAt     DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([eventId])
  @@index([ticketTypeId])
}

// Core Web Vitals reportadas pelo browser (via `/api/vitals`), agregadas por
// nome/métrica para o relatório de performance (auditoria #23).
model WebVital {
  id        String   @id @default(cuid())
  name      String
  rating    String
  value     Float
  delta     Float?
  path      String?
  createdAt DateTime @default(now())

  @@index([name])
  @@index([createdAt])
}
